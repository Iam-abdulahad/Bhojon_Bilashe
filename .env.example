# For local MongoDB, or replace with your MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/bhojon-bilash

# Use "resend" in production. "console" only previews emails during local development.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_EMAIL=

# International format digits for the restaurant's WhatsApp account (e.g. 8801XXXXXXXXX).
NEXT_PUBLIC_WHATSAPP_NUMBER=
